{
  "name": "google-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check server/gemini.js && node --check src/main.js"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "marked": "^16.2.1"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}